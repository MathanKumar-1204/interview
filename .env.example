# ==============================================================================
# AI Interview Studio - Environment Configuration
# Copy this file to .env and fill in your values.
# ==============================================================================

# Flask App Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Database Configuration (SQLite default; PostgreSQL example: postgresql://user:pass@localhost:5432/interview_studio)
DATABASE_URL=sqlite:///instance/interview_studio.db

# ElevenLabs Conversational AI Configuration
# Create your agent in the ElevenLabs Dashboard: https://elevenlabs.io/app/conversational-ai
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
# Auth mode: 'signed_url' (recommended for authenticated agents) or 'public' (for public prototype agents)
ELEVENLABS_AUTH_MODE=signed_url
# Allowed origin for agent requests (optional, e.g. http://localhost:5000)
ELEVENLABS_ALLOWED_ORIGIN=http://localhost:5000
# Webhook secret to verify requests from ElevenLabs tools or post-call webhooks
ELEVENLABS_WEBHOOK_SECRET=your_webhook_verification_secret_here

# LLM Configuration for Document Analysis, Interview Planning & Evaluation
# Supported providers: 'gemini' (recommended), 'openai', 'mock' (for offline testing)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Alternative: OpenAI (or OpenAI-compatible) Configuration
# LLM_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# File Upload Settings (in bytes, default: 10MB)
MAX_CONTENT_LENGTH=10485760
UPLOAD_FOLDER=instance/uploads
